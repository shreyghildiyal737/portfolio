# Copy this file to .env.local for local development.
# .env.local is git-ignored and must never be committed.

# Spring Boot backend URL.
# Leave empty to use the built-in Next.js /api/assistant route (local retrieval, no server needed).
# Set to http://localhost:8080 when running the Spring Boot backend from the /backend directory.
NEXT_PUBLIC_API_BASE_URL=

# ─── Visitor / workbench log ─────────────────────────────────────────────────
# Storage: leave these unset to use the local .data/ file store (dev only -
# serverless filesystems are ephemeral). Set them to use Upstash Redis in
# production. The store also accepts the KV_REST_API_URL / KV_REST_API_TOKEN
# names that the Vercel Upstash Marketplace integration provisions automatically,
# so on Vercel you usually don't set these by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner access for GET/DELETE /api/visitors and the /owner workbench.
# A long random secret. If unset, owner endpoints are locked (503), never open.
OWNER_TOKEN=

# Salt for hashing visitor IPs (rate-limit/dedupe only; raw IPs are never stored).
# If unset, no IP hash is kept and IP-based rate limiting is disabled.
VISITOR_IP_SALT=

# Optional: Discord webhook to get pinged when someone signs the guestbook.
# In Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# Leave unset to disable notifications (signatures still save normally).
DISCORD_WEBHOOK_URL=

# ─── AI Resume Assistant (/ask, RAG) ─────────────────────────────────────────
# Free-first. If these are unset the /ask page still works via local keyword
# search over data/knowledge/shrey-knowledge.md (no AI generation, no vector DB).
#
# Gemini API key (Google AI Studio - free tier). Used server-side for embeddings
# and answer generation. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (sensible free-tier defaults are used if unset):
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Supabase pgvector store for resume_chunks (see docs/rag-resume-assistant.md
# for the SQL). The URL is public; the SERVICE ROLE key is secret and is used
# ONLY server-side for ingestion and retrieval - never prefix it with NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used in metadata / absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
